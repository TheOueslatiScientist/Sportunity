# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sportunity

# JWT Secret (change this to a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Use mock data instead of real DB (set to "true" to skip PostgreSQL)
USE_MOCK_DATA=true

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
