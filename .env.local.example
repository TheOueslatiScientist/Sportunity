# ── Mode ──────────────────────────────────────────────────────────────────────
# true  → mock in-memory data (local dev, no Supabase needed)
# false → Prisma + Supabase (production / real data)
USE_MOCK_DATA=true

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtenir sur https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Obtenir sur Supabase → Settings → Database → Connection string (Transaction)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Connection string Direct (pour les migrations)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Auth (mode mock uniquement) ───────────────────────────────────────────────
JWT_SECRET=change-moi-en-production-secret-32-chars-min
